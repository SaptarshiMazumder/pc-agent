@startuml hexagonal-architecture
' ============================================================================
'  v2 Agent - Hexagonal / Ports & Adapters (Clean) architecture
'  Two sides: DRIVING (primary) adapters call IN; DRIVEN (secondary) ports are
'  called OUT. Each driven port is grouped with its own adapters to keep lines
'  short and non-crossing.
'  Render (from this folder):  java -jar ../../../plantuml.jar -tpng hexagonal-architecture.puml
' ============================================================================

left to right direction

skinparam backgroundColor #FAFAFA
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam nodesep 22
skinparam ranksep 95
skinparam ArrowColor #555555
skinparam ArrowFontColor #5A5A5A
skinparam ArrowFontSize 11
skinparam package {
  BorderColor #999999
  FontStyle bold
  FontSize 12
}
skinparam rectangle {
  BorderColor #888888
  roundCorner 10
}
skinparam note {
  BackgroundColor #FFF8DC
  BorderColor #C9B458
}

title v2 Agent - Hexagonal (Ports & Adapters / "Clean") Architecture\nDRIVING adapters call IN (left) -> CORE -> DRIVEN ports/adapters called OUT (right)\ngreen = in v2 today   amber = net-new   gray = port (interface)

' ===========================================================================
' DRIVING (PRIMARY) SIDE  -  things that call INTO the agent
' ===========================================================================
package "DRIVING adapters (call in)" #E8F0FE {
  rectangle "Desktop shell (Tauri/Electron)" as D_SHELL #DCEBFF
  rectangle "Web UI" as D_WEB #DCEBFF
  rectangle "Terminal" as D_TERM #DCEBFF
  rectangle "Messaging channels" as D_MSG #DCEBFF
}

rectangle "PORT\nAgentService\n(handle_message)" as P_DRV #E2E2E2

' ===========================================================================
' THE CORE  (the hexagon)
' ===========================================================================
package "HEXAGONAL CORE  (domain - no IO, no frameworks)" #EDE7F6 {
  rectangle "**Agent core**\norchestration + message/event types.\nTalks ONLY to the ports.\nDependencies point INWARD." as CORE #C7B8EA
}

' ===========================================================================
' DRIVEN (SECONDARY) SIDE  -  one box per port + its adapters
' ===========================================================================
package "Agent engine port" #F2F2F2 {
  rectangle "PORT: AgentEngine" as P_ENG #E2E2E2
  rectangle "Native loop [loop.py] (default)" as A_ENG1 #C8E6C9
  rectangle "Claude Agent SDK (Claude-only)" as A_ENG2 #FFE0B2
  rectangle "LangGraph" as A_ENG3 #FFE0B2
  P_ENG --> A_ENG1
  P_ENG --> A_ENG2
  P_ENG --> A_ENG3
}

package "Inference port" #F2F2F2 {
  rectangle "PORT: Inference" as P_INF #E2E2E2
  rectangle "**idle/hang timeout (120s) + request_timeout\n+ MODEL FAILOVER** [now, S11]\nfailover_stream: retry next model on a clean error" as A_INFG #C8E6C9
  rectangle "LiteLLM [llm.py]" as A_INF1 #C8E6C9
  rectangle "Local / BYOK / Secure-VM tiers" as A_INF2 #C8E6C9
  P_INF --> A_INFG
  A_INFG --> A_INF1
  P_INF --> A_INF2
}

package "Tools port" #F2F2F2 {
  rectangle "PORT: Tools" as P_TOOL #E2E2E2
  rectangle "**GuardedTool middleware** [now]\nper-tool timeout + retry + error-norm\n(policy: override > tool default > global)\nwraps EVERY tool, present + future" as A_GUARD #C8E6C9
  rectangle "core: read write edit ls find exec process\nweb_search web_fetch browser computer · MCP tools" as A_TOOL1 #C8E6C9
  rectangle "agent organs (flag-gated): cron · goal ·\nheartbeat_respond · report_outcome · commitment ·\nremember/memory_search/memory_get/consolidate ·\nspawn_subagent · skill_workshop · verify_answer" as A_TOOL2 #C8E6C9
  P_TOOL --> A_GUARD
  A_GUARD --> A_TOOL1
  A_GUARD --> A_TOOL2
}

package "Skills port  (loadable playbooks, read on demand)" #F2F2F2 {
  rectangle "PORT: SkillRegistry\nall() -> [name, description, path]" as P_SKILL #E2E2E2
  rectangle "FileSkills [now]\nskills/<name>/SKILL.md" as A_SKILL1 #C8E6C9
  rectangle "Cloud / per-user skill vault [later]" as A_SKILL2 #FFE0B2
  P_SKILL --> A_SKILL1
  P_SKILL --> A_SKILL2
}

package "Memory ports" #F2F2F2 {
  rectangle "PORT: SessionStore (transcripts)" as P_MEM #E2E2E2
  rectangle "LocalStore (JSONL) [now]" as A_MEM1 #C8E6C9
  rectangle "PORT: MemoryBank (long-term) [now, S4]" as P_BANK #E2E2E2
  rectangle "SqliteMemoryBank (FTS5 + LIKE) [now]\nremember/search/get/consolidate; cross-session" as A_MEM2 #C8E6C9
  rectangle "Vector / embeddings (same port) [later]" as A_MEM3 #FFE0B2
  P_MEM --> A_MEM1
  P_BANK --> A_MEM2
  P_BANK --> A_MEM3
}

package "Context port  [now, S7]" #F2F2F2 {
  rectangle "PORT: ContextPolicy\nprepare(messages) -> compacted view" as P_CTX #E2E2E2
  rectangle "WindowContextPolicy [now]\nrecent-N, boundary-safe (default off)" as A_CTX1 #C8E6C9
  rectangle "LLM-summary policy [later]" as A_CTX2 #FFE0B2
  P_CTX --> A_CTX1
  P_CTX --> A_CTX2
}

package "Channels + Notify ports  [now, 5a/5b]" #F2F2F2 {
  rectangle "PORT: Notifier / NotifyStore [now]" as P_NOT #E2E2E2
  rectangle "ClientPush · Store · ChannelNotifier [now]" as A_NOT1 #C8E6C9
  rectangle "PORT: Channel (poll + send) [now]" as P_CHN #E2E2E2
  rectangle "Email (Gmail MCP) · Memory(test) [now]\nWhatsApp/Slack/Telegram = +1 adapter" as A_CHN1 #C8E6C9
  P_NOT --> A_NOT1
  P_CHN --> A_CHN1
}

package "Sandbox port  [seam, S17]" #F2F2F2 {
  rectangle "PORT: Sandbox (run command)" as P_SBX #E2E2E2
  rectangle "LocalSandbox (host) [now]" as A_SBX1 #C8E6C9
  rectangle "Docker / SSH isolation [later]" as A_SBX2 #FFE0B2
  P_SBX --> A_SBX1
  P_SBX --> A_SBX2
}

package "Events port" #F2F2F2 {
  rectangle "PORT: EventSink" as P_EVT #E2E2E2
  rectangle "WebSocket gateway [gateway.py]" as A_EVT1 #C8E6C9
  rectangle "SSE / other transport" as A_EVT2 #FFE0B2
  P_EVT --> A_EVT1
  P_EVT --> A_EVT2
}

package "Policy / Guardrails port  (S13 DEFERRED - governance)" #F2F2F2 {
  rectangle "PORT: Policy\nauthorize(tool,args,ctx)\n= allow / deny / needs-approval" as P_POL #E2E2E2
  rectangle "Tier tool-allowlist" as A_POL1 #DDDDDD
  rectangle "Argument checks\n(paths, recipients, SSRF/egress)" as A_POL2 #DDDDDD
  rectangle "Rate limits / quotas" as A_POL3 #DDDDDD
  P_POL --> A_POL1
  P_POL --> A_POL2
  P_POL --> A_POL3
}

package "Approval port  (S13 DEFERRED - HITL)" #F2F2F2 {
  rectangle "PORT: Approval" as P_APR #E2E2E2
  rectangle "UI confirm / notify-and-wait\n(send email? destructive exec?\nfixes computer-tool ToS auto-ack)" as A_APR1 #DDDDDD
  P_APR --> A_APR1
}

package "Identity / Auth-profiles port" #F2F2F2 {
  rectangle "PORT: Auth / AuthProfileStore" as P_AUTH #E2E2E2
  rectangle "AuthProfile rotation + cooldown [now, S16]\n(multi-account; wiring to MCP/providers later)" as A_AUTH1 #C8E6C9
  rectangle "Control-plane auth (token) [later]" as A_AUTH2 #FFE0B2
  P_AUTH --> A_AUTH1
  P_AUTH --> A_AUTH2
}

package "Metering port" #F2F2F2 {
  rectangle "PORT: Metering" as P_MET #E2E2E2
  rectangle "Control-plane usage" as A_MET1 #FFE0B2
  P_MET --> A_MET1
}

' ===========================================================================
' DEPENDENCIES  (point INWARD: adapters -> ports -> core)
' ===========================================================================
D_SHELL --> D_WEB
D_WEB --> P_DRV
D_TERM --> P_DRV
D_MSG --> P_DRV
P_DRV --> CORE

CORE --> P_ENG
CORE --> P_INF
CORE --> P_TOOL
CORE --> P_SKILL
CORE --> P_MEM
CORE --> P_BANK
CORE --> P_CTX
CORE --> P_EVT
CORE --> P_NOT
CORE --> P_CHN
CORE --> P_SBX
CORE --> P_POL
CORE --> P_APR
CORE --> P_AUTH
CORE --> P_MET

note bottom of CORE
  Dependency rule: the CORE imports no adapter - it calls only the port interfaces.
  Swap any adapter (even the AGENT ENGINE: native loop / Claude SDK / LangGraph)
  without touching the core.
  --
  Tool chokepoint = the GuardedTool middleware wrapping EVERY tool (wired once in
  the composition root). Reliability binds here NOW: per-tool timeout + retry +
  error-norm, config-resolved (override > tool default > global). Governance binds
  here LATER: Auth gives entitlements -> Policy authorizes (allow / deny /
  needs-approval) -> Approval asks the human -> only then does the tool execute.
end note

note bottom of P_SKILL
  Skills port = loadable KNOW-HOW (markdown SKILL.md playbooks),
  distinct from the Tools port (callable actions). The core gets only
  one-line descriptions in the prompt; the agent reads a skill's full
  body on demand (via the read tool) when a request matches it.
  Add a skill = drop a file behind this port — no core change, no
  prompt bloat. Swappable: file folder now, cloud/per-user vault later.
end note

legend bottom
  | Color | Meaning |
  | green | exists in v2 today |
  | amber | net-new (platform) |
  | gray  | port = interface/socket |
endlegend

@enduml
