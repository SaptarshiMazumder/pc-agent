@startuml hexagonal-architecture
' ============================================================================
'  v2 Agent - Hexagonal / Ports & Adapters (Clean) architecture
'  Two sides: DRIVING (primary) adapters call IN; DRIVEN (secondary) ports are
'  called OUT. Each driven port is grouped with its own adapters to keep lines
'  short and non-crossing.
'  Render (from this folder):  java -jar ../../plantuml.jar -tpng hexagonal-architecture.puml
' ============================================================================

left to right direction

skinparam backgroundColor #FAFAFA
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam nodesep 22
skinparam ranksep 95
skinparam ArrowColor #555555
skinparam ArrowFontColor #5A5A5A
skinparam ArrowFontSize 11
skinparam package {
  BorderColor #999999
  FontStyle bold
  FontSize 12
}
skinparam rectangle {
  BorderColor #888888
  roundCorner 10
}
skinparam note {
  BackgroundColor #FFF8DC
  BorderColor #C9B458
}

title v2 Agent - Hexagonal (Ports & Adapters / "Clean") Architecture\nDRIVING adapters call IN (left) -> CORE -> DRIVEN ports/adapters called OUT (right)\ngreen = in v2 today   amber = net-new   gray = port (interface)

' ===========================================================================
' DRIVING (PRIMARY) SIDE  -  things that call INTO the agent
' ===========================================================================
package "DRIVING adapters (call in)" #E8F0FE {
  rectangle "Desktop shell (Tauri/Electron)" as D_SHELL #DCEBFF
  rectangle "Web UI" as D_WEB #DCEBFF
  rectangle "Terminal" as D_TERM #DCEBFF
  rectangle "Messaging channels" as D_MSG #DCEBFF
}

rectangle "PORT\nAgentService\n(handle_message)" as P_DRV #E2E2E2

' ===========================================================================
' THE CORE  (the hexagon)
' ===========================================================================
package "HEXAGONAL CORE  (domain - no IO, no frameworks)" #EDE7F6 {
  rectangle "**Agent core**\norchestration + message/event types.\nTalks ONLY to the ports.\nDependencies point INWARD." as CORE #C7B8EA
}

' ===========================================================================
' DRIVEN (SECONDARY) SIDE  -  one box per port + its adapters
' ===========================================================================
package "Agent engine port" #F2F2F2 {
  rectangle "PORT: AgentEngine" as P_ENG #E2E2E2
  rectangle "Native loop [loop.py] (default)" as A_ENG1 #C8E6C9
  rectangle "Claude Agent SDK (Claude-only)" as A_ENG2 #FFE0B2
  rectangle "LangGraph" as A_ENG3 #FFE0B2
  P_ENG --> A_ENG1
  P_ENG --> A_ENG2
  P_ENG --> A_ENG3
}

package "Inference port" #F2F2F2 {
  rectangle "PORT: Inference" as P_INF #E2E2E2
  rectangle "LiteLLM [llm.py]" as A_INF1 #C8E6C9
  rectangle "Local / BYOK / Secure-VM tiers" as A_INF2 #C8E6C9
  P_INF --> A_INF1
  P_INF --> A_INF2
}

package "Tools port" #F2F2F2 {
  rectangle "PORT: Tools" as P_TOOL #E2E2E2
  rectangle "read write edit ls find exec\nprocess web_search web_fetch browser" as A_TOOL1 #C8E6C9
  P_TOOL --> A_TOOL1
}

package "Memory port" #F2F2F2 {
  rectangle "PORT: Memory & History" as P_MEM #E2E2E2
  rectangle "LocalStore (JSONL) [now]" as A_MEM1 #C8E6C9
  rectangle "Cloud Memory Bank (E2E) [later]" as A_MEM2 #FFE0B2
  rectangle "Vector store / their server" as A_MEM3 #FFE0B2
  P_MEM --> A_MEM1
  P_MEM --> A_MEM2
  P_MEM --> A_MEM3
}

package "Events port" #F2F2F2 {
  rectangle "PORT: EventSink" as P_EVT #E2E2E2
  rectangle "WebSocket gateway [gateway.py]" as A_EVT1 #C8E6C9
  rectangle "SSE / other transport" as A_EVT2 #FFE0B2
  P_EVT --> A_EVT1
  P_EVT --> A_EVT2
}

package "Policy / Guardrails port  (checked before every tool runs)" #F2F2F2 {
  rectangle "PORT: Policy\nauthorize(tool,args,ctx)\n= allow / deny / needs-approval" as P_POL #E2E2E2
  rectangle "Tier tool-allowlist" as A_POL1 #FFE0B2
  rectangle "Argument checks\n(paths, recipients, SSRF/egress)" as A_POL2 #FFE0B2
  rectangle "Rate limits / quotas" as A_POL3 #FFE0B2
  P_POL --> A_POL1
  P_POL --> A_POL2
  P_POL --> A_POL3
}

package "Approval port  (human-in-the-loop)" #F2F2F2 {
  rectangle "PORT: Approval" as P_APR #E2E2E2
  rectangle "UI confirm prompt\n(send email? destructive exec?)" as A_APR1 #FFE0B2
  P_APR --> A_APR1
}

package "Identity port" #F2F2F2 {
  rectangle "PORT: Auth\n(login + entitlements)" as P_AUTH #E2E2E2
  rectangle "Control-plane auth (token)" as A_AUTH1 #FFE0B2
  P_AUTH --> A_AUTH1
}

package "Metering port" #F2F2F2 {
  rectangle "PORT: Metering" as P_MET #E2E2E2
  rectangle "Control-plane usage" as A_MET1 #FFE0B2
  P_MET --> A_MET1
}

' ===========================================================================
' DEPENDENCIES  (point INWARD: adapters -> ports -> core)
' ===========================================================================
D_SHELL --> D_WEB
D_WEB --> P_DRV
D_TERM --> P_DRV
D_MSG --> P_DRV
P_DRV --> CORE

CORE --> P_ENG
CORE --> P_INF
CORE --> P_TOOL
CORE --> P_MEM
CORE --> P_EVT
CORE --> P_POL
CORE --> P_APR
CORE --> P_AUTH
CORE --> P_MET

note bottom of CORE
  Dependency rule: the CORE imports no adapter - it calls only the port interfaces.
  Swap any adapter (even the AGENT ENGINE: native loop / Claude SDK / LangGraph)
  without touching the core.
  --
  Guardrails flow (before every tool runs): Auth gives entitlements -> Policy
  authorizes the call (allow / deny / needs-approval) -> if needs-approval, the
  Approval port asks the human -> only then does the Tools port execute.
end note

legend bottom
  | Color | Meaning |
  | green | exists in v2 today |
  | amber | net-new (platform) |
  | gray  | port = interface/socket |
endlegend

@enduml
