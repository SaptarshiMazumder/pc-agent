@startuml desktop-cloud-mode-request-flow
' ============================================================================
'  agentd desktop - CLOUD MODE (platform keys)
'  Activity-flowchart view. The daemon, state and tools remain LOCAL.
'  Render (from this folder):
'    java -jar ../../../plantuml.jar -tpng desktop-cloud-mode-request-flow.puml
' ============================================================================

skinparam backgroundColor #FAFAFA
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam ArrowColor #555555
skinparam ArrowFontColor #444444
skinparam ArrowFontSize 11
skinparam ActivityBorderColor #6A6A6A
skinparam ActivityBackgroundColor #FFFFFF
skinparam ActivityDiamondBackgroundColor #FFF4E5
skinparam ActivityDiamondBorderColor #C9A227
skinparam NoteBackgroundColor #FFF8DC
skinparam NoteBorderColor #C9B458
skinparam partitionBorderColor #9AA0B5
skinparam partitionFontStyle bold
skinparam partitionFontSize 13

title Desktop Client - CLOUD Mode (platform keys)\nLocal agentd execution; hosted authentication, model proxy, provider keys and metering

start

partition "0 . DESKTOP SIGN-IN - auth.ts" #E8F0FE {
  :User enters email + password;
  :**auth.login()** -> Accounts `POST /login`;
}

partition "1 . HOSTED ACCOUNTS SERVICE :4100 - deploy/accounts/app.py" #FFF0F0 {
  :verify password; create account session;
  :return {sess_ token, account_id, email};
}

partition "0 . DESKTOP STARTUP + CLOUD MODE BINDING" #E8F0FE {
  :save Session in desktop localStorage;
  :**Supervisor.ensure()**  (supervisor.ts)\nfind or spawn LOCAL `python -m agentd`;
  :**GatewayClient.connect()** to localhost :8787\nusing the daemon's separate machine token;
  :Cloud mode -> **connectPlatform()**  (store.ts)\n`GatewayClient.request("platform.connect", {sess_ token})`;
}

partition "2 . LOCAL PRESENTATION - Gateway (gateway.py)" #FDECEA {
  :**Gateway._handle_conn()** authenticates the desktop\nwith the LOCAL machine token;
  :**Gateway._platform_connect()**\npersist sess_ token as AGENTD_MODEL_PROXY_KEY\nin local ~/.agentd/.env;
}

partition "3 . LOCAL INFRASTRUCTURE - model_proxy.py" #F3E8FF {
  :**model_proxy.configure(config)**\nenable hosted api_base from distribution/config;\nuse sess_ token as model-proxy credential;
}

note right
  TWO DIFFERENT TOKENS
  - machine token: Desktop -> local Gateway
  - sess_ token: local LiteLLM adapter -> hosted Model Proxy
end note

partition "4 . DESKTOP CLIENT - React UI + GatewayClient" #E8F0FE {
  :User types a message;
  :**store.ts :: sendMessage()**\nadd optimistic user bubble; mark session running;
  :**GatewayClient.request("chat.send")**\n{sessionKey, message, agentId, projectId,\n attachments, idempotencyKey};
}

partition "5 . LOCAL PRESENTATION - Gateway + RunHandle" #FDECEA {
  :**Gateway._dispatch() -> _chat_send()**\nvalidate message/agent; save attachments locally;\napply idempotency + active-run checks;
  :create **RunHandle**\n{runId, sessionKey, abort, client_id};
  :start `asyncio.create_task(Gateway._run(...))`;
  :return correlated WebSocket `res {runId}` IMMEDIATELY\n(the background run continues);
}

partition "6 . LOCAL APPLICATION - AgentService + RunContext" #E6F4EA {
  :**Gateway._run()** creates the EventSink callback\nthen calls **AgentService.handle_message()**;
  :resolve agent through the injected **AgentRegistry** port;
}

partition "7 . LOCAL INFRASTRUCTURE - registry adapter" #F3E8FF {
  :**FileAgentRegistry.get(agentId)**\nread agents/<id> -> return AgentSpec;
}

partition "8 . LOCAL DOMAIN - pure types and rules (no I/O)" #FFF4E5 {
  :**AgentSpec + RunMode.INTERACTIVE**;
  :**select_tools() + apply_mode()**\nreturn the tools this agent may use;
  :construct **UserMessage**;
}

partition "6 . LOCAL APPLICATION - AgentService + RunContext" #E6F4EA {
  :set **RunContext**\n{agent_id, workspace, plugin/model overrides};
}

partition "7 . LOCAL INFRASTRUCTURE - SessionStore" #F3E8FF {
  :**SessionStore.load()** local JSONL transcript;
  :**SessionStore.append(UserMessage)**;
}

partition "6 . LOCAL APPLICATION - AgentService" #E6F4EA {
  :build system prompt\nidentity + context + skill descriptions + tool schemas;
  :invoke concrete **NativeEngine.run()** through AgentEngine port;
}

repeat
  partition "9 . LOCAL INFRASTRUCTURE - NativeEngine + LiteLLM adapter" #EDE7F6 {
    :begin one **run_agent_loop()** turn;
    :**litellm_stream()** converts local domain Message[]\n+ prompt + tool schemas to completion arguments;
    :**model_proxy.apply(kwargs)**\nmodel = litellm_proxy/<model>\napi_base = hosted Model Proxy\napi_key = sess_ token;
  }

  partition "10 . HOSTED MODEL PROXY :4000 - v2/model-proxy" #FFF0F0 {
    :receive OpenAI-compatible streaming completion;
    :**custom_auth.user_api_key_auth()**\nmaster key? NO -> session-token path;
  }

  if (token -> account_id cached?) then (yes)
    partition "10 . HOSTED MODEL PROXY :4000" #FFF0F0 {
      :reuse short-TTL account_id cache;
    }
  else (no)
    partition "1 . HOSTED ACCOUNTS SERVICE :4100" #FFF0F0 {
      :Model Proxy calls `GET /resolve`\nAuthorization: Bearer sess_...;
      if (session token valid?) then (yes)
        :return account_id;
      else (no)
        :reject invalid/expired token;
        stop
      endif
    }
  endif

  partition "10 . HOSTED MODEL PROXY :4000" #FFF0F0 {
    :authentication accepted;\nload real provider key from model-proxy environment\n(seeded from AWS Secrets Manager);
  }

  partition "11 . EXTERNAL MODEL PROVIDER" #E0F2F1 {
    :run completion using PLATFORM provider key;
    :stream thinking, visible text, tool-call chunks and usage;
  }

  partition "10 . HOSTED MODEL PROXY :4000" #FFF0F0 {
    :proxy streaming chunks back to the local daemon;
    :**AccountsUsageLogger.async_log_success_event()**\nextract account_id + token counts + cost;
    :Accounts `POST /usage`\n{account_id, model, in_tokens, out_tokens, cost_usd}\nwith X-Internal-Key;
  }

  partition "1 . HOSTED ACCOUNTS SERVICE :4100" #FFF0F0 {
    :append the authoritative usage-ledger row;
  }

  partition "9 . LOCAL INFRASTRUCTURE - NativeEngine + LiteLLM adapter" #EDE7F6 {
    :normalize proxied chunks;\nbuild **AssistantMessage** + **AgentEvent** values;
  }

  partition "12 . LIVE OUTPUT - Local Presentation -> Desktop" #E3F2FD {
    :on every delta, **Gateway._broadcast()** wraps the AgentEvent\nas a `chat.event` local WebSocket frame;
    :**GatewayClient.handleFrame() -> store.handleAgentEvent()**\nrender thinking/text/tool progress immediately;
  }

  switch (What did AssistantMessage contain?)

  case ( TOOL CALLS )
    partition "9 . LOCAL INFRASTRUCTURE - local tool execution" #EDE7F6 {
      :validate and run selected Tool LOCALLY\nfiles / exec / browser / web / MCP / plugin tool\nthrough its GuardedTool wrapper;
    }
    partition "8 . LOCAL DOMAIN - messages.py" #FFF4E5 {
      :construct **ToolResultMessage**\n(+ Artifact values / error);
    }
    partition "7 . LOCAL INFRASTRUCTURE - SessionStore" #F3E8FF {
      :persist AssistantMessage + ToolResultMessage locally;
    }
    partition "9 . LOCAL INFRASTRUCTURE - NativeEngine" #EDE7F6 {
      :append ToolResultMessage to local Message[];\nnext turn repeats the METERED proxy path;
    }

  case ( FINAL TEXT )
    partition "9 . LOCAL INFRASTRUCTURE - completion policy" #EDE7F6 {
      if (planning-only, reasoning-only, empty,\nfollow-up queued, or verification requests revision?) then (INCOMPLETE)
        :inject continuation/follow-up/revision message\nand continue the loop;
      else (GENUINELY DONE)
        :accept AssistantMessage as final;
      endif
    }

  case ( ERROR / ABORT )
    partition "9 . LOCAL INFRASTRUCTURE - NativeEngine" #EDE7F6 {
      :mark stopReason = error or aborted;
    }

  endswitch

repeat while (another model turn required?) is (yes) not (no)

partition "13 . FINAL OUTPUT + LOCAL PERSISTENCE" #E0F2F1 {
  :**SessionStore.append(AssistantMessage)** locally;
  :emit **AgentEvent("agent_end", {stopReason})**;
  :**Gateway._broadcast() -> GatewayClient -> Zustand store**;
  :mark session not running; show final answer to user;
}

stop

note right
  CLOUD MODE BOUNDARY
  LOCAL: Gateway, AgentService, RunContext, Message[], NativeEngine,
         SessionStore, workspace and every Tool.
  HOSTED: account authentication, provider keys, model forwarding,
          account attribution and usage ledger.
end note

note right
  The local desktop daemon has accounts.enabled() == false.
  It does not authenticate its WebSocket with the account token
  and does not write usage. Proxy-side metering is authoritative.
end note

legend left
  | Layer/service | Exact implementation shown |
  | Desktop | Supervisor, GatewayClient, auth.ts, store.ts |
  | Local Presentation | Gateway, RunHandle, WebSocket req/res/event |
  | Local Application | AgentService, RunContext, injected ports |
  | Local Domain | AgentSpec, RunMode, Message types, AgentEvent, rules |
  | Local Infrastructure | FileAgentRegistry, SessionStore, NativeEngine, LiteLLM, Tools |
  | Hosted Accounts | /login, /resolve, /usage |
  | Hosted Model Proxy | user_api_key_auth, AccountsUsageLogger, provider secrets |
endlegend

@enduml
