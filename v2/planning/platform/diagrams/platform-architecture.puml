@startuml components
' ============================================================================
' agentd platform — CANONICAL architecture (2026-07-18 reassessment)
' Source of truth for the cloud/platform build. PUML only; do not render PNG
' unless explicitly asked. Five @startuml blocks in this file:
'   1. components   — the 4 components + hard boundaries
'   2. planes       — compute vs state vs distribution (engine holds no data)
'   3. run-x-pay    — the 2x2: where the engine runs x how models are paid
'   4. request-flow — one chat turn, desktop-subscription AND browser
'   5. share-flow   — create-as-folder -> share link -> run in ~5s
' ============================================================================
title agentd platform — four components, hard boundaries

skinparam shadowing false
skinparam componentStyle rectangle
skinparam defaultFontName Segoe UI
skinparam defaultFontSize 12
skinparam TitleFontSize 17
skinparam package {
  BackgroundColor #FAFAFA
  BorderColor #888888
}
skinparam note {
  BackgroundColor #FFFBE6
  BorderColor #C8B900
}

actor "Creator\n(authors an agent as a folder)" as CREATOR
actor "User\n(runs an agent)" as USER

package "CLIENTS (doors — never logic)" as CLIENTS #F0FFF0 {
  rectangle "Desktop app / Agent exe\n(engine runs on THEIR machine)" as DESK
  rectangle "Browser\n(engine runs on OUR fleet)" as WEB
}

package "(1) CORE ENGINE = agentd\nsame code on desktop OR our fleet" as CORE #EAF3FF {
  rectangle "gateway + agent loop\nsessions - memory - run context" as LOOP
  rectangle "BUILT-IN tools/plugins\n(fs, web, shell, figures, ...)\nSHIP INSIDE THE IMAGE — they are SOFTWARE" as BUILTIN
  rectangle "AGENT-authored plugins\nrun here (desktop) or in a SANDBOX (web)" as AGENTPLUG
}

package "(2) PLATFORM SERVER (our cloud brain — serves ALL users)" as PLAT #FFF5F0 {
  rectangle "Accounts\nsign-in, issues account token" as ACC
  rectangle "Model Proxy  (the 'Cursor server')\nholds OUR provider keys, meters per account,\nenforces subscription/limits. BYOK bypasses it." as GW
  rectangle "Marketplace Registry\npublished .agentpkg + listings;\nthe listing IS the share link" as REG
}

package "(3) HOSTED RUNTIME\n(our fleet running engines for BROWSER users; multi-user)" as HOST #EAF3FF {
  rectangle "engine instances (same image as CORE)\nper-connection user_id -> that user's state" as HENG
}

package "(4) AGENTS = DATA (.agentpkg)" as AGENTS #F5F0FF {
  rectangle "agent.toml - IDENTITY.md - ui/\nskills/ - (optional) plugins/\nNEVER baked into the engine image" as PKG
}

rectangle "LLM / VLM providers\n(Anthropic, Google, ...) — we RENT, never own" as LLM

CREATOR --> DESK : author + publish
USER --> DESK
USER --> WEB
DESK --> CORE : local engine
WEB --> HOST : wss
CORE ..> ACC : sign-in (account token)
CORE ..> GW : model calls (subscription)\nOR direct to provider (BYOK)
HENG ..> GW : model calls (always via gateway)
GW --> LLM
CORE ..> REG : install / publish
HENG ..> REG : pull on demand
PKG ..> CORE : loaded + interpreted
PKG ..> HENG : loaded + interpreted

note bottom of CORE
  BOUNDARY: the engine CONSUMES a token + a model endpoint.
  It NEVER owns accounts, billing, provider keys, or the storefront.
end note
note bottom of PLAT
  BOUNDARY: the platform server runs NO agents.
  It issues identity, meters models, and serves packages.
end note
@enduml


@startuml planes
title Three planes — and the one iron rule

skinparam shadowing false
skinparam componentStyle rectangle
skinparam defaultFontName Segoe UI
skinparam defaultFontSize 12
skinparam TitleFontSize 17
skinparam package {
  BackgroundColor #FAFAFA
  BorderColor #888888
}
skinparam note {
  BackgroundColor #FFFBE6
  BorderColor #C8B900
}

package "COMPUTE plane (cattle — disposable)" as COMPUTE #EAF3FF {
  rectangle "engine fleet (runs the image)\n+ model proxy box\nkill / replace / scale freely" as CMP
  rectangle "image shelf (the program)" as IMG
}

package "STATE plane (crown jewels — durable, isolated per account)" as STATE #FFF0F0 {
  database "accounts + subscriptions + listings\n(structured records)" as DB
  database "per-user state roots\n/users/<uid>/agents, sessions, memory\n(a live filesystem)" as FS
  database "uploaded files + .agentpkg blobs\n(object store)" as OBJ
}

package "DISTRIBUTION plane" as DIST #F5F0FF {
  rectangle "marketplace registry\n(reads OBJ + DB above)" as MKT
}

CMP --> DB : look up account / limits
CMP --> FS : read agent + history, write back
CMP --> OBJ : fetch package / files
IMG ..> CMP : pulled to run
MKT ..> OBJ
MKT ..> DB

note bottom of COMPUTE
  RULE #5: ENGINE BOXES HOLD NO USER DATA, EVER.
  A compute box can die and be replaced with ZERO loss,
  because all durable state lives in the STATE plane.
  (Desktop is the extreme case: the user's machine IS their state plane.)
end note
@enduml


@startuml run-x-pay
title Two independent axes — where the engine runs x how models are paid

skinparam shadowing false
skinparam componentStyle rectangle
skinparam defaultFontName Segoe UI
skinparam defaultFontSize 12
skinparam TitleFontSize 16
skinparam package {
  BackgroundColor #FAFAFA
  BorderColor #888888
}
skinparam note {
  BackgroundColor #FFFBE6
  BorderColor #C8B900
}

package "DESKTOP / EXE  (engine on THEIR machine)" as D #F0FFF0 {
  rectangle "BYOK\ntheir key, calls provider direct.\nOur platform not in the path. Free to us.\n= today's mode" as DBYOK
  rectangle "SUBSCRIPTION\nsign in; local engine calls our\nModel Proxy with account token.\nNo key setup ever. = the CURSOR model" as DSUB
}

package "BROWSER  (engine on OUR hosted runtime)" as B #EAF3FF {
  rectangle "BYOK\ntheir key in their account vault;\nour hosted engine uses it. (later)" as BBYOK
  rectangle "SUBSCRIPTION\nengine + state + models all our side,\nmetered per account. = the CHATGPT model" as BSUB
}

note bottom of D
  SAME engine in all four cells. The ONLY thing that changes is one seam:
  model endpoint + credential = (provider, their key)  OR  (our gateway, account token).
end note
@enduml


@startuml request-flow
title One chat turn — desktop+subscription and browser, same engine

skinparam shadowing false
skinparam defaultFontName Segoe UI
skinparam defaultFontSize 12
skinparam TitleFontSize 16
skinparam sequence {
  ArrowColor #444444
  LifeLineBorderColor #888888
  ParticipantBackgroundColor White
}
skinparam note {
  BackgroundColor #FFFBE6
  BorderColor #C8B900
}

participant "User" as U
participant "Engine\n(local OR hosted)" as E
participant "State plane\n(their agent + history)" as S
participant "Model Proxy" as G
participant "Provider" as P

U -> E : message
E -> S : load agent folder + history\n(local disk, OR /users/<uid> on our fleet)
E -> G : model call + ACCOUNT TOKEN\n(subscription)
note right of G : check subscription/limits,\nforward with OUR key, METER the account
G -> P : call with our provider key
P --> G : completion
G --> E : streamed reply
E -> S : save transcript
E --> U : answer

note over U, P
  BYOK differs at ONE step: the engine calls the Provider directly with the
  user's own key; the Model Proxy is not in the path (and nothing is metered).
end note
@enduml


@startuml share-flow
title Create-as-folder -> share a link -> run in ~5 seconds

skinparam shadowing false
skinparam defaultFontName Segoe UI
skinparam defaultFontSize 12
skinparam TitleFontSize 16
skinparam sequence {
  ArrowColor #444444
  LifeLineBorderColor #888888
  ParticipantBackgroundColor White
}
skinparam note {
  BackgroundColor #FFFBE6
  BorderColor #C8B900
}

actor "Creator" as C
participant "Registry\n(S3 + DB)" as R
actor "Recipient" as V
participant "Hosted Runtime\n(shared engine fleet)" as H
participant "Recipient's state root" as S

C -> R : publish agents/sushi-desk/\n(folder -> .agentpkg; exe built server-side)
R --> C : listing + share link
C -> V : send link

alt open in browser
  V -> H : click link (sign in)
  H -> R : pull sushi .agentpkg
  H -> S : unpack folder into /users/<uid>/agents/sushi-desk\n(seconds — it is a FOLDER, no deployment)
  H --> V : serve the agent's own UI  ~5s
else get the app
  V -> R : download Sushi Desk Setup.exe
  note right of V : engine + agent in one installer;\nfinds-or-starts local daemon
end

note over H, S
  A thousand shared agents add a thousand FOLDERS on the state plane,
  NOT a thousand deployments. That is why 5-second share scales.
  Trust tiers: data-only agents (identity/skills/ui/built-in tools) are hostable
  for strangers now; agents with CUSTOM PLUGINS need the sandbox rung on web
  (desktop runs them day one, on the user's own machine).
end note
@enduml
