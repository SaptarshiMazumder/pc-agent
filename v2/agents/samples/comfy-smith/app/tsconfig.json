{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      // The types half of the vendoring in vite.config.ts. Vite resolves the RUNTIME import via
      // its alias; TypeScript knows nothing about that and would report "cannot find module
      // '@agentd/client'" on every file. This points the compiler at the .d.ts beside the bundle.
      "@agentd/client": ["./vendor/agentd-client.d.ts"]
    }
  },
  "include": ["src"]
}
