  "pitfalls": [
    {
      "symptom": "out of memory",
      "cause": "bf16/fp16 diffusion files need >27 GB, fp8 >16 GB; E1.1 fp16 OOMs even on A100 40 GB",
      "fix": "fp8 I1 files; E1.1 with weight_dtype fp8_e4m3fn_fast; community: Q8 GGUF (18.7 GB) fits 24 GB; offload encoders (--lowvram)",
      "src": [
        "S-DOCS-I1",
        "S-DOCS-E1",
        "S-COMMUNITY-VRAM"
      ]
    },
    {
      "symptom": "encoder load fails / gated download",
      "cause": "trying the diffusers meta-llama path or fewer than four encoders",
      "fix": "QuadrupleCLIPLoader with the four Comfy-Org fp8-scaled files (Llama is 9 GB)",
      "src": [
        "S-DOCS-I1",
        "S-NODES"
      ]
    },
    {
      "symptom": "washed / wrong output on Dev or Fast",
      "cause": "cfg above 1 or a negative prompt on a distilled variant",
      "fix": "cfg 1.0, ignore the negative",
      "src": "S-DOCS-I1"
    },
    {
      "symptom": "Dev looks off",
      "cause": "shift 3.0 on Dev (needs 6.0) or 6.0 on Full/Fast (need 3.0)",
      "fix": "per-variant shift: Full 3, Dev 6, Fast 3",
      "src": [
        "S-TPL-FULL",
        "S-DOCS-I1"
      ]
    },
    {
      "symptom": "E1-Full edit is poor or wildly different",
      "cause": "input not 768x768",
      "fix": "ImageScale bilinear 768x768 center (the recipe does it)",
      "src": "S-DOCS-E1"
    },
    {
      "symptom": "E1.1 output aspect differs from the input",
      "cause": "ImageScaleToTotalPixels to 1 MP may change the ratio",
      "fix": "crop/resize deliberately before the stage if the exact ratio matters",
      "src": "S-DOCS-E1"
    },
    {
      "symptom": "E1.1 result differs from the official demo",
      "cause": "the official pipeline adds a refine_strength=0.3 I1-Full refinement pass that the Comfy graph lacks; template also uses 20 steps vs 28",
      "fix": "raise steps to 28; accept the difference or chain an I1-Full img2img pass",
      "src": "S-GH-E1"
    },
    {
      "symptom": "E1.1 negative seems ignored",
      "cause": "the official template wires the Positive encode into DualCFGGuider.negative (link 452); only InstructPixToPixConditioning.negative receives the negative text",
      "fix": "rewire DualCFGGuider.negative to the Negative encode (as E1-Full and the official script do) if the negative must act",
      "src": [
        "S-TPL-E11",
        "S-TPL-E1",
        "S-GH-E1"
      ]
    },
    {
      "symptom": "'unknown model' on an old build",
      "cause": "ComfyUI before commit 9ad792f9",
      "fix": "the pinned 0.35.0 image is far newer",
      "src": "S-DOCS-I1"
    },
    {
