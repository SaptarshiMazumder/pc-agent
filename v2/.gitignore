# secrets
.env

# runtime data (sessions, screenshots)
.agentd/

# virtual environments — never commit (any name / depth)
.venv/
.venv
venv/
venv
env/
**/.venv/
pyvenv.cfg

# python
__pycache__/
*.py[cod]
.pytest_cache/

# scratch
tmp/

# wheel-build staging (hatch hook) — presence of these flips packaged mode; never commit
agent_runtime/_builtin_plugins/
agent_runtime/_data/

# wheel build artifacts
dist/
misc/
misc/**
**/misc/
# Terraform state — machine-specific, contains resource IDs and sometimes secrets.
tfstates/
*.tfstate
*.tfstate.*
.terraform/
