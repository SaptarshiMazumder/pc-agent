# secrets
#
# `.env` ALONE WAS NOT ENOUGH. It matches exactly one filename, and set-keys.ps1 reads a file
# PER ENVIRONMENT -- .env.staging, .env.production -- none of which that pattern covers. Those
# files hold live provider keys, the payment rail's credentials and DATABASE_URL; the only
# reason none has ever been committed is that nobody happened to `git add` one.
#
# The negation keeps the two tracked templates visible, which is what makes the pattern safe
# to widen: .env.example is the thing people copy FROM, and it holds no values.
.env
.env.*
!.env.example

# runtime data (sessions, screenshots)
.agentd/

# virtual environments — never commit (any name / depth)
.venv/
.venv
venv/
venv
env/
**/.venv/
pyvenv.cfg

# python
__pycache__/
*.py[cod]
.pytest_cache/

# scratch
tmp/

# wheel-build staging (hatch hook) — presence of these flips packaged mode; never commit
agent_runtime/_builtin_plugins/
agent_runtime/_data/

# wheel build artifacts
dist/
misc/
misc/**
**/misc/
# Terraform state — machine-specific, contains resource IDs and sometimes secrets.
tfstates/
*.tfstate
*.tfstate.*
.terraform/
**/business/
