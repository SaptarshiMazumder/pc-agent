{
  "mcp_servers": [
    {
      "name": "google",
      "command": [
        "uvx",
        "workspace-mcp",
        "--tools",
        "gmail",
        "drive",
        "calendar"
      ],
      "env": {
        "OAUTHLIB_INSECURE_TRANSPORT": "1"
      }
    }
  ],
  "channels": [
    {
      "type": "line",
      "agent": "sakana-sushi",
      "policy": "allowlist",
      "allow_from": [
        "*"
      ],
      "webhook_path": "/line/webhook"
    }
  ],
  "webhook_host": "0.0.0.0",
  "webhook_port": 8788
}