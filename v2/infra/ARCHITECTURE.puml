@startuml
' =====================================================================================
' agentd - AWS architecture, as DEPLOYED in staging (ap-northeast-1), 2026-09-08.
'
' Drawn from the terraform in v2/infra/modules/ AND verified against the live account,
' because the two disagree in places worth seeing: the module still defaults every
' service to Fargate, while staging has moved all five onto EC2 bridge networking.
'
' Render:  java -jar plantuml.jar -tpng v2/infra/ARCHITECTURE.puml
' This file is deliberately PURE ASCII so it renders identically in every viewer -
' the VS Code extensions invoke plantuml without -charset, and any non-ASCII
' separator then comes out as a row of empty boxes.
' awslib14 ships inside plantuml's standard library - no network fetch needed.
' =====================================================================================
!include <awslib14/AWSCommon>
!include <awslib14/AWSSimplified>

!include <awslib14/NetworkingContentDelivery/Route53>
!include <awslib14/NetworkingContentDelivery/CloudFront>
!include <awslib14/NetworkingContentDelivery/ElasticLoadBalancingApplicationLoadBalancer>
!include <awslib14/NetworkingContentDelivery/VPCInternetGateway>
!include <awslib14/Compute/EC2>
!include <awslib14/Compute/Lambda>
!include <awslib14/Containers/ElasticContainerService>
!include <awslib14/Containers/ElasticContainerServiceService>
!include <awslib14/Containers/ElasticContainerRegistry>
!include <awslib14/Storage/SimpleStorageService>
!include <awslib14/Storage/EFS>
!include <awslib14/Database/DynamoDB>
!include <awslib14/SecurityIdentityCompliance/SecretsManager>
!include <awslib14/SecurityIdentityCompliance/KeyManagementService>
!include <awslib14/SecurityIdentityCompliance/CertificateManager>
!include <awslib14/ManagementGovernance/CloudWatch>
!include <awslib14/ApplicationIntegration/SimpleNotificationService>
!include <awslib14/ApplicationIntegration/EventBridge>

skinparam backgroundColor #FFFFFF
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam roundcorner 8
skinparam shadowing false
skinparam ArrowColor #4A4A5A
skinparam ArrowFontSize 10
skinparam ArrowFontColor #3A3A4A

skinparam rectangle {
  BorderColor #B8B5C8
  FontColor #1C1B22
}
skinparam note {
  BackgroundColor #FFF8E1
  BorderColor #D9B44A
  FontSize 10
}

title agentd - AWS architecture (staging, ap-northeast-1) - verified against the live account 2026-09-08

' ----------------------------------------------------------- clients
actor "Browser\n(web client)" as browser
actor "Desktop app\n(agentd daemon)" as desktop

' ----------------------------------------------------------- edge
rectangle "Edge - DNS - CDN" as edge #F4F2FB {
  Route53(dns, "Route 53", "staging.thorgodofthunder.site\napex + *.wildcard -> ALB\nmarketplace.* -> CloudFront\nagentd.local (private, empty)")
  CertificateManager(certAlb, "ACM - regional", "ALB listeners\napex + *.domain")
  CertificateManager(certCf, "ACM - us-east-1", "CloudFront only reads\ncerts from us-east-1")
  CloudFront(cdn, "CloudFront", "marketplace storefront\nPriceClass_200 - 2 origins")
}

' ----------------------------------------------------------- VPC
rectangle "VPC  10.0.0.0/16   -   NO NAT - NO private subnets" as vpc #EEF4FB {

  VPCInternetGateway(igw, "Internet Gateway", "one public route table\n0.0.0.0/0 -> igw")

  ElasticLoadBalancingApplicationLoadBalancer(alb, "Application Load Balancer", "internet-facing - idle_timeout 4000s\nTLS 1.3 terminates here")

  rectangle "Public subnets (only kind that exists)" as subnets #E3EDF7 {
    rectangle "AZ ap-northeast-1a\n10.0.1.0/24" as az1 {
      EC2(ec2a, "t3.medium", "ECS container instance\nIMDSv2 required")
    }
    rectangle "AZ ap-northeast-1c\n10.0.2.0/24" as az2 {
      EC2(ec2b, "t3.medium", "ECS container instance\nIMDSv2 required")
    }
  }

  ElasticContainerService(ecs, "ECS cluster 'agentd-staging'", "capacity provider: EC2 only\nASG min 0 / max 2 / desired 2\nmanaged scaling, target 100 (bin-pack)")

  rectangle "ECS services - all 5 on **EC2 + bridge** (bin-packed across both instances)" as svcs #E8F2E8 {
    ElasticContainerServiceService(web, "web :80", "nginx - static UI + admin console\n256 CPU / 512 MB")
    ElasticContainerServiceService(daemon, "daemon :8787", "THE AGENT ENGINE - WebSocket\n1024 CPU / 2048 MB\ndrain 120s - stop 150s")
    ElasticContainerServiceService(accounts, "accounts :4100", "identity - credits - payments\n512 CPU / 1024 MB - admin plane")
    ElasticContainerServiceService(proxy, "model-proxy :4000", "LiteLLM - meters every call\n256 CPU / 512 MB")
    ElasticContainerServiceService(ingest, "ingest :4200", "telemetry intake\n256 CPU / 512 MB")
  }

  EFS(efs, "EFS /data", "daemon ONLY (accounts left on\nthe Postgres migration)\nper-account state + workspaces\n~396 MB - encrypted")

  Lambda(sched, "scheduled-jobs", "the one Lambda INSIDE the VPC\n128 MB - 60s - python3.12\nrelay -> accounts by private DNS")
}

' ----------------------------------------------------------- serverless
rectangle "Serverless - deliberately OUTSIDE the VPC\n(no NAT, so in-VPC would have no route to S3)" as lambdas #FBF0F4 {
  Lambda(builder, "builder :4400", "compiles an agent's app/ -> ui/\nnpm + vite - 3008 MB - 600s\n2 GB ephemeral")
  Lambda(executor, "executor :4500", "**UNTRUSTED CODE RUNS HERE**\none Firecracker microVM per call\n2048 MB - 900s - 4 GB ephemeral\nimage built FROM the daemon image")
  Lambda(publish, "publish :4300", "signs .agentpkg + builds the\nWindows installer (makensis)\n2048 MB - 300s")
}

' ----------------------------------------------------------- data
rectangle "Data & secrets" as data #F7F3E8 {
  SimpleStorageService(s3scratch, "builder-scratch", "conveyor belt - 1-day expiry\nSHARED by builder + executor\n(sources, workspaces, broker slots)")
  SimpleStorageService(s3registry, "registry", "public marketplace objects\npending/* carved OUT of public read")
  SimpleStorageService(s3market, "marketplace", "storefront SPA - CloudFront OAC only")
  DynamoDB(ddb, "3 tables", "creators (PITR)\nbundle-owners (PITR)\npublish-locks (TTL)")
  KeyManagementService(kms, "KMS", "wraps Ed25519 creator keys\n(KMS cannot sign Ed25519)")
  SecretsManager(secrets, "agentd/staging/app", "provider keys - identity KEK\npayment rails - internal keys")
  ElasticContainerRegistry(ecr, "ECR", "5 service images + 3 lambda images")
}

' ----------------------------------------------------------- observability
rectangle "Observability" as obs #F0F0F5 {
  CloudWatch(cw, "CloudWatch", "/agentd/staging - 14-day retention\n2 dashboards: service-health, business\n~13 alarms (spend, ledger, 5xx, auth)")
  EventBridge(evb, "EventBridge Scheduler", "renewals hourly\nclose-expired 00:05 - snapshot 00:20")
  SimpleNotificationService(sns, "SNS alerts", "email subscription")
}

' ----------------------------------------------------------- external
cloud "External services" as ext #F5F5F5 {
  rectangle "Neon Postgres\n(accounts DB - outside AWS)" as neon
  rectangle "Model providers\nOpenAI - Gemini - DeepSeek - Moonshot" as providers
  rectangle "User's own ComfyUI\n(vast / runpod / local)" as comfy
}

' =========================================================== traffic
browser --> dns : DNS
desktop --> dns : DNS
dns --> alb : A alias\napex + *.wildcard
dns --> cdn : marketplace.*
certAlb ..> alb : TLS
certCf ..> cdn : TLS

cdn --> s3market : site (OAC)
cdn --> s3registry : catalog.json / index.json\n(caching DISABLED)

igw <--> alb
alb --> web : 443 / 80
alb --> proxy : 4000
alb --> accounts : 4100
alb --> ingest : 4200
alb --> daemon : 8787 (WebSocket)
' One edge, not three: each Lambda is an ALB target on its own listener port
' (named in each Lambda's label). Three separate edges crossed the whole canvas.
alb ..> lambdas : lambda targets\non listeners 4300 / 4400 / 4500

ecs --> ec2a
ecs --> ec2b
ecs ..> svcs : places tasks
daemon --> efs : /data (NFS 2049)

' =========================================================== app flows
daemon --> proxy : every model call\n(master key)
proxy --> providers : upstream
proxy --> accounts : meter + cap\n(internal key)
daemon --> accounts : resolve token\n(JWT verified LOCALLY via JWKS)
accounts --> neon : SQL
daemon ..> comfy : agent tools reach the\nuser's own instance

daemon --> builder : build an agent window
builder <--> s3scratch : sources in / ui out
daemon --> executor : **untrusted tool call**\n(sandbox job)
executor <--> s3scratch : code + workspace zips\nbroker request/response slots
executor ..> daemon : model & fetch calls brokered BACK\n(credentials never leave the daemon)

publish --> s3registry
publish --> ddb
publish --> kms
accounts ..> publish : creator admission\n(admin plane)

sched --> accounts : billing jobs\n(private DNS, internal key)
evb --> sched : 3 cron schedules

secrets ..> svcs : injected as ECS secrets
ecr ..> svcs : images (5 services + 3 lambdas)
svcs --> cw : awslogs, 14-day retention
lambdas --> cw : logs (NO retention set - gap)
cw --> sns : alarms

legend right
  **Reading this diagram**
  Blue = inside the VPC (every subnet is public).
  Pink = serverless, deliberately outside the VPC.
  Sand = data + secrets.   Lilac = edge/DNS/CDN.   Grey = observability.
  ----
  Solid arrows = request path.
  Dashed arrows = config, images, logs, brokered calls.
  ----
  Ports shown are ALB **listener** ports; every one is
  internet-facing today (see security-group note).
endlegend

' =========================================================== notes
note right of vpc
  **Everything is in public subnets, on purpose.**
  There is no NAT gateway (~$32/mo saved), so every
  task needs a public IP to reach ECR, Secrets Manager,
  CloudWatch and Neon. Security is by security group,
  not by subnet placement.
end note

note bottom of svcs
  **Cloud Map (agentd.local) is currently EMPTY.**
  It only publishes A records for awsvpc tasks; bridge
  needs SRV, which HTTP clients cannot resolve. So since
  the EC2 move, service-to-service calls hairpin out
  through the public ALB instead of staying in the VPC -
  a round trip + TLS on every auth check.
end note

note right of executor
  **This is the trust boundary.**
  A marketplace plugin's tools, an authored agent's
  Python, and the builder's shell all execute here -
  one microVM per invocation - never on the daemon
  that holds every tenant's files.
end note

note bottom of ext
  Neon is reached over the public internet.
  An RDS security group exists in the terraform
  with no RDS behind it - leftover scaffolding.
end note

@enduml
