@startuml
' =====================================================================================
'  agentd - AWS architecture, as DEPLOYED in staging (ap-northeast-1), 2026-09-08.
'
'  Drawn from the terraform in v2/infra/modules/ AND verified against the live account,
'  because the two disagree: the module still defaults every service to Fargate, while
'  staging has moved all five onto EC2 bridge networking.
'
'  READ IT TOP TO BOTTOM. Every arrow is a REQUEST. Plumbing that is not a request -
'  TLS certs, container images, secret injection, log shipping - is written into the
'  boxes instead, because drawing it turned this into a hairball.
'
'  Render:  java -jar plantuml-1.2025.10.jar -tpng ARCHITECTURE.puml
'  Pure ASCII on purpose: the VS Code extensions call plantuml without -charset, and
'  anything else comes out as empty boxes. awslib14 is bundled in the jar.
' =====================================================================================
!include <awslib14/AWSCommon>
!include <awslib14/AWSSimplified>
!include <awslib14/NetworkingContentDelivery/Route53>
!include <awslib14/NetworkingContentDelivery/CloudFront>
!include <awslib14/NetworkingContentDelivery/ElasticLoadBalancingApplicationLoadBalancer>
!include <awslib14/Compute/EC2>
!include <awslib14/Compute/Lambda>
!include <awslib14/Containers/ElasticContainerServiceService>
!include <awslib14/Storage/SimpleStorageService>
!include <awslib14/Storage/EFS>
!include <awslib14/Database/DynamoDB>
!include <awslib14/SecurityIdentityCompliance/SecretsManager>
!include <awslib14/ManagementGovernance/CloudWatch>

skinparam backgroundColor #FFFFFF
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam shadowing false
skinparam roundcorner 10
skinparam linetype ortho
skinparam nodesep 28
skinparam ranksep 46
skinparam ArrowColor #5A5A6E
skinparam ArrowFontSize 11
skinparam ArrowFontColor #33333F
skinparam rectangle {
  BorderColor #B9B6C7
  FontColor #1C1B22
  FontSize 12
}

title agentd - AWS architecture (staging, ap-northeast-1) - verified against the live account, 2026-09-08

' ============================================================ 1. clients
actor "Browser" as browser
actor "Desktop app" as desktop

' ============================================================ 2. edge
rectangle "Edge" as edge #F4F2FB {
  Route53(dns, "Route 53", "apex + *.wildcard -> ALB\nmarketplace.* -> CloudFront")
  CloudFront(cdn, "CloudFront", "marketplace storefront")
}

' ============================================================ 3. the one front door
ElasticLoadBalancingApplicationLoadBalancer(alb, "Application Load Balancer", "9 listeners, ALL internet-facing\nTLS 1.3 terminated here (ACM)\nidle_timeout 4000s for WebSockets")

' ============================================================ 4. compute
rectangle "VPC  10.0.0.0/16  -  2 public subnets (1a / 1c), IGW, NO NAT, no private subnets" as vpc #EEF4FB {

  rectangle "ECS cluster - 2 x t3.medium, EC2 + bridge, bin-packed\nimages from ECR - secrets from Secrets Manager - logs to CloudWatch (14d)" as svcs #E8F2E8 {
    ElasticContainerServiceService(daemon, "daemon :8787", "THE AGENT ENGINE\nWebSocket - 1024 CPU / 2048 MB")
    ElasticContainerServiceService(accounts, "accounts :4100", "identity - credits - payments\n512 CPU / 1024 MB")
    ElasticContainerServiceService(proxy, "model-proxy :4000", "LiteLLM - meters every call\n256 CPU / 512 MB")
    ElasticContainerServiceService(web, "web :80", "static UI + admin\n256 / 512")
    ElasticContainerServiceService(ingest, "ingest :4200", "telemetry intake\n256 / 512")
  }

  EFS(efs, "EFS /data", "daemon state + workspaces")
  Lambda(sched, "scheduled-jobs", "billing cron relay\nthe only Lambda IN the VPC")
}

rectangle "Lambdas - outside the VPC (no NAT, so in-VPC has no route to S3)" as lambdas #FBF0F4 {
  Lambda(executor, "executor :4500", "UNTRUSTED CODE RUNS HERE\none Firecracker microVM per call\n2048 MB - 900s")
  Lambda(builder, "builder :4400", "compiles agent app/ -> ui/\n3008 MB - 600s")
  Lambda(publish, "publish :4300", "signs .agentpkg + installer\n2048 MB - 300s")
}

' ============================================================ 5. state
rectangle "Data" as data #F7F3E8 {
  SimpleStorageService(scratch, "S3 builder-scratch", "job conveyor, 1-day expiry\nshared: builder + executor")
  SimpleStorageService(pub, "S3 registry + marketplace", "public agent registry\nstorefront (CloudFront OAC)")
  DynamoDB(ddb, "DynamoDB + KMS", "creators - bundle owners - locks\nKMS wraps Ed25519 keys")
}

' Named inside the boxes above rather than wired with arrows: every service reaches
' these, and drawing 8 more edges is what made the first version unreadable.
rectangle "Supporting - reached by everything, no request path drawn" as support #F0F0F5 {
  SecretsManager(secrets, "Secrets Manager", "provider keys - identity KEK\npayment rails")
  CloudWatch(cw, "CloudWatch", "2 dashboards - ~13 alarms -> SNS")
}

' ============================================================ 6. off-AWS
rectangle "Outside AWS" as ext #F2F2F2 {
  rectangle "Neon Postgres\n(accounts database)" as neon
  rectangle "Model providers\nOpenAI - Gemini - DeepSeek - Moonshot" as providers
  rectangle "The user's own ComfyUI\n(vast / runpod / local)" as comfy
}

vpc -[hidden]right- lambdas
data -[hidden]right- support

' ============================================================ requests only
browser --> dns
desktop --> dns
dns --> alb : "apex + *.wildcard"
dns --> cdn : "marketplace.*"
cdn --> pub

alb --> svcs : "443 - 4000 - 4100 - 4200 - 8787"
alb --> lambdas : "4300 - 4400 - 4500"

daemon --> accounts : "resolve token"
daemon --> proxy : "every model call"
daemon --> efs
daemon --> executor : "untrusted tool call"
daemon --> builder : "build a window"
daemon ..> comfy : "agent tools"

executor --> scratch
builder --> scratch
publish --> pub
publish --> ddb

proxy --> providers
proxy --> accounts : "meter + cap"
accounts --> neon
sched --> accounts : "billing jobs"

legend right
  **Arrows are requests only.** Images (ECR), secret injection,
  TLS certificates and log shipping are named inside the boxes.
  ----
  **Three facts worth knowing**
  1. Every subnet is public and all 9 ALB ports face the internet.
     There is no NAT, so every task needs a public IP to reach
     ECR, Secrets Manager, CloudWatch and Neon.
  2. Since the EC2 move, Cloud Map (agentd.local) is EMPTY - it only
     publishes A records for awsvpc tasks. So daemon -> accounts,
     a check on every request, now hairpins out through the public ALB.
  3. The executor is the trust boundary: a marketplace plugin's tools,
     an authored agent's Python and the builder's shell all run there,
     one microVM per call, never on the daemon that holds every
     tenant's files.
endlegend

@enduml
