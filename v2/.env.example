# ============================================================================
#  agentd environment.  KEYS/SECRETS at the top — fill them in.
#  .env and .env.example are kept IDENTICAL except .env holds the real secrets.
#  agentd loads ONLY v2/.env (anchored to the v2 folder).  NEVER commit .env.
# ============================================================================

# ── KEYS / SECRETS (fill these) ─────────────────────────────────────────
# LLM providers: litellm auto-selects the key from the model's "provider/" prefix.
# GEMINI_API_KEY -> gemini/*   (get one at https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# OPENAI_API_KEY -> openai/*
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY -> anthropic/*
# ANTHROPIC_API_KEY=

# Local model server (LM Studio / Ollama — OpenAI-compatible) for lm_studio/* models
# LM_STUDIO_API_BASE=http://localhost:1234/v1
# LM_STUDIO_API_KEY=lm-studio

# Web search (optional)
# BRAVE_API_KEY=
# PARALLEL_API_KEY=

# Google Workspace MCP (gmail/drive/calendar) — OAuth, not an API key
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ── MODELS (per function) ────────────────────────────────────────────────
# FLEXIBLE (litellm "provider/model" — gemini/openai/anthropic/lm_studio/...):
AGENTD_MODEL=gemini/gemini-3.1-pro-preview
AGENTD_REASONING=medium
# AGENTD_MODEL_FALLBACKS=gemini/gemini-2.5-flash,openai/gpt-4o
AGENTD_VERIFY_MODEL=gemini/gemini-2.5-flash
# AGENTD_RESOURCE_SUMMARY_MODEL=lm_studio/qwen2.5-7b-instruct   # text summaries (any provider)
#
# GEMINI-ONLY (these use Google features / google-genai — keep on Gemini):
AGENTD_SEARCH_MODEL=gemini/gemini-2.5-flash                     # web-search grounding
# AGENTD_SEARCH_PROVIDERS=gemini,parallel,duckduckgo
AGENTD_RESOURCE_VISION_MODEL=gemini-2.5-flash                   # image captions (vision)
# AGENTD_COMPUTER_MODEL=gemini-2.5-computer-use-preview-10-2025 # computer use

# ── QUALITY + LIVENESS ───────────────────────────────────────────────────
AGENTD_LIVENESS=callrate,noprogress
AGENTD_VERIFY_TOOL=1
AGENTD_COMPLETENESS_CHECK=1

# ── PERSONA / HONESTY (S1, S3) ───────────────────────────────────────────
AGENTD_PERSONA=1

# ── MEMORY + CONTEXT (S4-S7) ─────────────────────────────────────────────
AGENTD_MEMORY=1
AGENTD_CONTEXT_MAX=0

# ── SUB-AGENTS + SKILLS (S8-S10) ─────────────────────────────────────────
AGENTD_SUBAGENTS=1
AGENTD_SKILL_WORKSHOP=1

# ── AUTONOMY + RELIABILITY (P2, S14/S15, 5a) ─────────────────────────────
AGENTD_AUTONOMY=1
AGENTD_NOTIFY=1
AGENTD_ENFORCE_OUTCOME=1
AGENTD_CRON_FAILURE_ALERT=3
# AGENTD_HEARTBEAT_INTERVAL=30m
# AGENTD_GOOGLE_ACCOUNT=

# ── RESOURCES: described index + vision + text summaries ─────────────────
AGENTD_RESOURCES=1
AGENTD_RESOURCE_VISION=1
AGENTD_RESOURCE_SUMMARIZE=1

# ── BROWSER ──────────────────────────────────────────────────────────────
AGENTD_HEADLESS=0
AGENTD_BROWSER_PLAYWRIGHT=1
AGENTD_BROWSER_AGENT_BROWSER=0

# ── COMPUTER USE (OFF by default — sends full-screen screenshots) ────────
AGENTD_COMPUTER_ENABLED=0
AGENTD_COMPUTER_SEND_MAX=1440
AGENTD_COMPUTER_SAVE_SCREENSHOTS=1
AGENTD_COMPUTER_PAUSE=0.02
AGENTD_COMPUTER_SETTLE=0.1
AGENTD_COMPUTER_TYPE_INTERVAL=0

# ── OTHER (non-agentd; from a standalone tool — agentd ignores these) ────
CAPTURE_MODE=auto
SEND_MAX=1600
VERIFY_RETRIES=2
# BACKEND=gemini
# GEMINI_MODEL=gemini-2.5-computer-use-preview-10-2025
# MAX_ITERATIONS=40
