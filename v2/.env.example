# ============================================================================
#  agentd .env — KEYS / SECRETS ONLY.
#
#  All behavioural KNOBS now live in  v2/agent_runtime.config.json  (one typed place).
#  IMPORTANT: any AGENTD_* var set HERE still OVERRIDES agentd.config.json — so
#  keep knobs OUT of this file, or they win silently. (Model/provider knobs no
#  longer read any env var at all; they live only in the config's "plugins" block.)
#
#  agentd loads ONLY v2/.env (anchored to the v2 folder). NEVER commit .env.
# ============================================================================

# ── LLM PROVIDER KEYS (litellm auto-selects the key from the model's "provider/" prefix) ──
#    Any litellm provider works — add its STANDARD key env var here (see docs.litellm.ai).
# GEMINI_API_KEY  -> gemini/*   (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# OPENAI_API_KEY=            # openai/*
# ANTHROPIC_API_KEY=         # anthropic/*
# DEEPSEEK_API_KEY=          # deepseek/*
# XAI_API_KEY=               # xai/*  (grok)
# OPENROUTER_API_KEY=        # openrouter/*

# ── IMAGE-GEN BACKEND KEYS (optional; the backend itself is chosen in agentd.config.json
#    via plugins.figure-art.tools.generate_artwork.provider: gemini|fal|replicate) ──
# FAL_KEY=                   # fal.ai        ($10 minimum) — pip install fal-client
# REPLICATE_API_TOKEN=       # replicate.com (no minimum) — pip install replicate

# ── LOCAL MODEL SERVER (LM Studio / Ollama — OpenAI-compatible) for lm_studio/* models ──
# LM_STUDIO_API_BASE=http://localhost:1234/v1
# LM_STUDIO_API_KEY=lm-studio

# ── WEB SEARCH KEYS (optional; provider chain is a knob in agentd.config.json) ──
# BRAVE_API_KEY=
# PARALLEL_API_KEY=

# ── GOOGLE WORKSPACE MCP (gmail/drive/calendar) — OAuth, not an API key ──
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ── LOGIN VAULT (the simple_login tool): a Fernet master key that encrypts saved logins.
#    Unset = vault OFF. Generate one with:  python -m agent_runtime.main.add_login --genkey ──
# AGENTD_VAULT_KEY=

# ── DEPLOYMENT URL (optional). Not a secret — you may instead set "public_url" in
#    agentd.config.json. Your ngrok/tunnel/domain, enables tappable /connect links. ──
# AGENTD_PUBLIC_URL=https://your-subdomain.ngrok-free.dev

# ── STANDALONE TOOL (NOT agentd — a separate script reads these; agentd ignores them) ──
CAPTURE_MODE=auto
SEND_MAX=1600
VERIFY_RETRIES=2
