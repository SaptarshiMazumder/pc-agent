# agentd environment — copy to v2/.env and fill in. agentd loads ONLY v2/.env
# (anchored to the v2 folder), so v2 is independent of any .env outside it.

# --- LLM provider key (LiteLLM reads these directly) -------------------------
# Set the one matching your model. Default model is gemini/gemini-2.5-pro.
GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# --- Model / reasoning -------------------------------------------------------
# Any LiteLLM model id. Examples:
#   gemini/gemini-2.5-pro | anthropic/claude-... | openai/gpt-5.5
AGENTD_MODEL=gemini/gemini-2.5-pro
# Thinking level: off | low | medium | high
AGENTD_REASONING=medium

# --- Web search (optional) ---------------------------------------------------
# If unset, web_search falls back to keyless DuckDuckGo.
# BRAVE_API_KEY=

# --- Gateway / runtime (optional; defaults shown) ----------------------------
# AGENTD_HOST=127.0.0.1
# AGENTD_PORT=8787
# AGENTD_HEADLESS=true
# AGENTD_WORKSPACE=.            # working dir the agent operates in
# AGENTD_STATE_DIR=             # sessions/screenshots (default: v2/.agentd)
