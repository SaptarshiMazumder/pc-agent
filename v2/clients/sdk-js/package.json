{
  "name": "@agentd/client",
  "version": "0.1.0",
  "description": "Official client SDK for the agentd gateway protocol \u2014 works in the browser (agent apps), Node, and Electron. Transport-agnostic: connect to a local daemon or a hosted one with the same code.",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && node scripts/vendor.mjs",
    "vendor": "node scripts/vendor.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "devDependencies": {
    "@agentd/auth": "file:../auth",
    "@agentd/billing": "file:../billing",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0"
  }
}
