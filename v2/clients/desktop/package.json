{
  "name": "agentd-desktop",
  "productName": "agentd",
  "version": "0.1.5",
  "description": "agentd desktop shell — chat, agents, and the marketplace over the local agentd daemon",
  "main": "./out/main/index.js",
  "author": "agentd",
  "license": "UNLICENSED",
  "scripts": {
    "predev": "node scripts/kill-daemon.mjs && node scripts/sync-platform-urls.mjs",
    "dev": "electron-vite dev",
    "predev:studio": "node scripts/kill-daemon.mjs && node scripts/sync-platform-urls.mjs",
    "dev:studio": "cross-env AGENTD_FLAVOR=figure-creator-studio electron-vite dev",
    "build": "electron-vite build",
    "dev:web": "vite --config vite.config.web.ts",
    "build:web": "vite build --config vite.config.web.ts",
    "preview:web": "vite preview --config vite.config.web.ts",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "sync:urls": "node scripts/sync-platform-urls.mjs --strict",
    "gen:app": "node scripts/gen-app-flavor.mjs",
    "dist:app": "node scripts/dist-app.mjs",
    "dist:core": "electron-vite build && electron-builder --config electron-builder.yml",
    "dist:studio": "electron-vite build && electron-builder --config electron-builder.studio.yml"
  },
  "dependencies": {
    "@fontsource/bricolage-grotesque": "^5.2.10",
    "@fontsource/hanken-grotesk": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@iarna/toml": "^2.2.5",
    "fabric": "^7.4.0",
    "lucide-react": "^1.23.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "remark-gfm": "^4.0.0",
    "ws": "^8.21.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.4",
    "cross-env": "^7.0.3",
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
