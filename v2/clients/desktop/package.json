{
  "name": "agentd-desktop",
  "productName": "agentd",
  "version": "0.1.6",
  "description": "agentd desktop shell — the Electron host for the shared @agentd/ui renderer: supervisor, native file access, installers",
  "main": "./out/main/index.js",
  "author": "agentd",
  "license": "UNLICENSED",
  "scripts": {
    "predev": "node scripts/kill-daemon.mjs && node scripts/sync-platform-urls.mjs",
    "dev": "electron-vite dev",
    "predev:studio": "node scripts/kill-daemon.mjs && node scripts/sync-platform-urls.mjs",
    "dev:studio": "cross-env AGENTD_FLAVOR=figure-creator-studio electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json",
    "sync:urls": "node scripts/sync-platform-urls.mjs --strict",
    "gen:app": "node scripts/gen-app-flavor.mjs",
    "dist:app": "node scripts/dist-app.mjs",
    "dist:core": "electron-vite build && electron-builder --config electron-builder.yml",
    "dist:studio": "electron-vite build && electron-builder --config electron-builder.studio.yml"
  },
  "dependencies": {
    "@iarna/toml": "^2.2.5",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@agentd/ui": "*",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.4",
    "cross-env": "^7.0.3",
    "electron": "34.5.8",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
