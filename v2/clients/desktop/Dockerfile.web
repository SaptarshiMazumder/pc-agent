# Web client image — the SAME renderer the desktop app uses, built as a static site and served
# by nginx. Build context = clients/desktop/. The daemon/accounts URLs are baked at BUILD time
# (vite inlines VITE_* env), so pass them as build args per target:
#   local compose -> http://localhost:4100 + ws://localhost:8790
#   cloud         -> the same-origin/public URLs (set in CI)
#
#   docker build -t agentd-webui -f Dockerfile.web \
#     --build-arg VITE_AGENTD_ACCOUNTS_URL=http://localhost:4100 \
#     --build-arg VITE_AGENTD_URL=ws://localhost:8790 .

# --- build stage ---------------------------------------------------------------
FROM node:20-slim AS build
WORKDIR /app
COPY package.json package-lock.json* ./
RUN npm ci 2>/dev/null || npm install
COPY . .
ARG VITE_AGENTD_ACCOUNTS_URL
ARG VITE_AGENTD_URL
ENV VITE_AGENTD_ACCOUNTS_URL=$VITE_AGENTD_ACCOUNTS_URL \
    VITE_AGENTD_URL=$VITE_AGENTD_URL
RUN npm run build:web   # -> dist-web/

# --- serve stage ---------------------------------------------------------------
FROM nginx:alpine
COPY --from=build /app/dist-web /usr/share/nginx/html
COPY nginx.web.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
