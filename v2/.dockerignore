# Build context = v2/. Keep it lean: the image needs agentd/ + plugins/ + agents/ +
# pyproject.toml + scripts/ (wheel build) + deploy/docker/. Everything else stays out.

# secrets — NEVER bake into an image
.env
**/.env

# desktop/terminal clients (incl. the ~1GB bundled CPython runtime) and their builds
clients/

# …EXCEPT the agent-app SDK's source, which the daemon image compiles in its own `sdk` stage
# (deploy/docker/Dockerfile). Every agent app loads that file, and `clients/` being excluded here
# — on top of `dist/` being gitignored — is why the built image carried no canonical SDK at all,
# quietly disabling both pack-time re-vendoring and the serve-time substitution that keeps
# already-created agents current. Source only: node_modules/ and dist/ stay out (the stage runs
# its own `npm ci`), and nothing else under clients/ is re-admitted.
!clients/sdk-js/package.json
!clients/sdk-js/package-lock.json
!clients/sdk-js/tsconfig.json
!clients/sdk-js/tsup.config.ts
!clients/sdk-js/src

# …and @agentd/auth, which the SDK imports as `file:../auth`. It is the ONE sign-in and
# token-renewal implementation on this platform (clients/auth), shared with the agentd client so
# neither owns a second one — which means the sdk stage cannot compile without it. Same rule as
# above: the manifest and the source, nothing else.
!clients/auth/package.json
!clients/auth/src

# delivered per-agent products (installers) — never part of the source image
agents/*/clients/

# dev state, tests, docs, planning
.agentd/
tests/
planning/
docs/
misc/
workshops/

# build/junk
dist/
**/__pycache__/
**/*.pyc
**/node_modules/
# agent workspace DATA only — never a bare **/workspace/, which would also swallow
# the agent_runtime.infrastructure.workspace source package (it did, once)
agents/*/workspace/
.agentd/workspace/
*.agentpkg
plantuml.jar
