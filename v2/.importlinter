[importlinter]
root_package = agentd
include_external_packages = True

[importlinter:contract:clean-layers]
name = Clean architecture layers (domain <- application <- infrastructure/presentation <- main)
type = layers
layers =
    agentd.main
    agentd.presentation
    agentd.infrastructure
    agentd.application
    agentd.domain

[importlinter:contract:core-not-import-plugins]
name = Core (agentd) must not import plugin implementations (plugins are the outermost ring)
type = forbidden
source_modules =
    agentd
forbidden_modules =
    plugins
# Tool/capability implementations live in plugins/ (built-in bundles + third-party), discovered at
# runtime. The dependency rule points INWARD: plugins may import the framework surface (Tool,
# ToolResult, domain types), but the core never reaches outward to a plugin. (Built-in bundles
# import by bare module name on the loader's sys.path; agentd never names `plugins` statically.)
