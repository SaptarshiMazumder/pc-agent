# Copy to ".env" and fill in. Never commit the real .env.
#
# Backend is auto-selected: if GEMINI_API_KEY is set you get the Gemini
# computer-use backend; otherwise the Anthropic one. Force with BACKEND=.

# --- Gemini backend (local CLI, no Discord) ---
# Key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your-google-ai-studio-key
# GEMINI_MODEL=gemini-2.5-computer-use-preview-10-2025

# --- Anthropic backend (used by bot.py / Discord, and local.py if no Gemini key) ---
ANTHROPIC_API_KEY=sk-ant-...
MODEL=claude-sonnet-4-6

# --- Discord transport (only needed to run bot.py) ---
DISCORD_TOKEN=your-discord-bot-token
DISCORD_OWNER_ID=123456789012345678

# --- web browser (agent-browser: CDP + accessibility @refs, OpenClaw's engine) ---
# DEFAULT mirrors OpenClaw's actual default profile: a dedicated, persistent,
# managed, HEADED browser you log into ONCE (NOT your real Chrome). It stays warm
# and reconnects on later runs, so you won't see a fresh window each time.
# One-time login:  agent-browser --profile "$HOME\.pc_agent_browser_profile" --headed open "https://www.linkedin.com"
BROWSER_HEADLESS=             # blank/0 = headed (default, like OpenClaw); 1 = hidden (after you've logged in)
BROWSER_PROFILE=             # persistent profile dir (blank = ~/.pc_agent_browser_profile); cookies persist
BROWSER_CLOSE_ON_DONE=       # blank = keep browser warm between runs (OpenClaw-like); 1 = close when a task ends
BROWSER_FRESH=               # 1 = force a clean restart instead of reconnecting (use after changing modes below)
# OPT-IN: use your REAL Chrome session instead (OpenClaw's "user" profile, not its default):
BROWSER_ATTACH=              # 1 = attach to your already-running Chrome (your real logins).
                             # Requires Chrome started with remote debugging, e.g.:
                             #   chrome.exe --remote-debugging-port=9222 --user-data-dir="%LOCALAPPDATA%\Google\Chrome\User Data"
BROWSER_CDP=                 # attach to a specific CDP port instead, e.g. 9222

# --- model-agnostic agent (lc_agent.py: LangGraph + LiteLLM) ---
# Pick any provider/model via LiteLLM — one-line switch, no code change.
MODEL=gemini/gemini-2.5-pro        # default brain, uses GEMINI_API_KEY below
#   gemini/gemini-2.5-flash        (faster/cheaper, but drops constraints more often)
#   anthropic/claude-opus-4-8      (ANTHROPIC_API_KEY)
#   openai/gpt-4.1                 (OPENAI_API_KEY)
#   deepseek/deepseek-chat         (DEEPSEEK_API_KEY)
#   moonshot/kimi-k2.5             (MOONSHOT_API_KEY)
#   minimax/MiniMax-Text-01        (MINIMAX_API_KEY)
# Provider keys (set the one(s) you use):
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=
# MOONSHOT_API_KEY=
# MINIMAX_API_KEY=

# --- autonomous tool agent (auto.py / brain.py) ---
# Hybrid brain: a strong model plans/decides, a fast one executes.
BRAIN_MODEL=gemini-2.5-flash   # executor — runs the mechanical tool steps
STRATEGY_MODEL=gemini-2.5-pro  # strategist — picks the simplest approach first
PLANNER_MODEL=gemini-2.5-pro   # planner for orchestrated (-o) runs
REFLECT=1                      # 1 = run the strategist before executing; 0 = skip
PRIORITY=accuracy              # accuracy = always ground in real sources + cite URLs
                               # (never answer from memory); speed = fastest adequate
SHELL_APPROVAL=risky           # risky = prompt only for installs/deletes/system
                               # changes; all = prompt every command; never = full auto
SHELL_TIMEOUT=300
TAVILY_API_KEY=                # for the web_search tool (https://tavily.com)
AGENT_MAX_STEPS=50

# Gmail + Calendar tools (read-only). Download an OAuth "Desktop app" client
# JSON from Google Cloud Console (enable Gmail + Calendar APIs) and save it as
# credentials.json. First use opens a browser for consent; token cached below.
GOOGLE_CLIENT_SECRET=credentials.json
GOOGLE_TOKEN=token.json

# --- shared / optional ---
BACKEND=                    # gemini | anthropic (blank = auto)
MAX_ITERATIONS=40
POST_SCREENSHOTS=true
REQUIRE_BASH_APPROVAL=true

# --- Gemini capture (computer use) ---
COMPUTER_ENV=desktop        # desktop = drive the whole PC (taskbar, native apps)
                            # browser = restrict to web pages only
                            # mobile  = mobile UI
CAPTURE_MODE=auto           # auto    = whole desktop until a browser opens, then
                            #           lock onto that window (recommended)
                            # window  = always prefer the tracked window
                            # desktop = always the whole desktop, every app
SEND_MAX=1600               # cap on the longest screenshot side sent to the model
VERIFY_RETRIES=2            # orchestrator: attempts per step before moving on
