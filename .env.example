# Copy to ".env" and fill in. Never commit the real .env.
#
# Backend is auto-selected: if GEMINI_API_KEY is set you get the Gemini
# computer-use backend; otherwise the Anthropic one. Force with BACKEND=.

# --- Gemini backend (local CLI, no Discord) ---
# Key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your-google-ai-studio-key
# GEMINI_MODEL=gemini-2.5-computer-use-preview-10-2025

# --- Anthropic backend (used by bot.py / Discord, and local.py if no Gemini key) ---
ANTHROPIC_API_KEY=sk-ant-...
MODEL=claude-sonnet-4-6

# --- Discord transport (only needed to run bot.py) ---
DISCORD_TOKEN=your-discord-bot-token
DISCORD_OWNER_ID=123456789012345678

# --- shared / optional ---
BACKEND=                    # gemini | anthropic (blank = auto)
MAX_ITERATIONS=40
POST_SCREENSHOTS=true
REQUIRE_BASH_APPROVAL=true

# --- Gemini capture (computer use) ---
CAPTURE_MODE=auto           # auto    = whole desktop until a browser opens, then
                            #           lock onto that window (recommended)
                            # window  = always prefer the tracked window
                            # desktop = always the whole desktop, every app
SEND_MAX=1600               # cap on the longest screenshot side sent to the model
VERIFY_RETRIES=2            # orchestrator: attempts per step before moving on
