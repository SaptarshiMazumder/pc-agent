# Virtual environments — never commit, any name / any depth (with and without
# trailing slash so they match even before the directory exists)
.venv/
.venv
venv/
venv
env/
ENV/
**/.venv/
**/venv/
*.venv/
pyvenv.cfg

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.import_linter_cache/

# tokensave MCP code-graph index (local cache; regenerated by the server) — never commit.
# The .db + WAL/SHM churn on every code change and cause merge conflicts.
.tokensave/*.db
.tokensave/*.db-wal
.tokensave/*.db-shm

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment / secrets
.env
.env.local
*.local
credentials.json
token.json
run.log

# Claude / editor / tooling
.claude/
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Reference material at the repo root (never committed). ANCHORED on purpose: the unanchored
# `reference/` also swallowed v2/agents/agent-builder/skills/build-agent/reference/ — the format
# docs the build-agent skill tells the builder to read — so no clone or CI-built image ever had
# them. Skill reference pages are product content and must ship.
/reference/

# Agent scratch workspaces — never committed
v2/agents/*/workspace/

# Agent BUILT PRODUCTS (installer exes delivered by the app factory) — derived from the
# .agentpkg, hundreds of MB; live with their agent but never in git or in the package
v2/agents/*/clients/

# Local telemetry capture — the dev dashboard's input (monitoring/dev_dashboard.py).
# Metrics normally go to stdout only; AGENTD_TELEMETRY_FILE also appends here for local viewing.
*.telemetry.jsonl
v2/.telemetry.jsonl

# daemon runtime caches (written to state_dir; never source)
jwks-cache.json
platform-discovery.json

# design-sync (staged scripts, build output, machine state)
.ds-sync/
ds-bundle/
.design-sync/.cache/
.design-sync/learnings/
.design-sync/node_modules
